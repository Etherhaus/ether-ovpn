import { ListView } from "std-widgets.slint";

export enum ConnState { idle, connecting, connected, disconnecting, error }

export struct ProfileInfo {
    // Index in the store, so a filtered list still maps back to the right profile.
    index: int,
    name: string,
    saved-password: bool,
}

export enum UpdateState { idle, checking, available, downloading, installing, done, failed }

// Every user-visible string. Filled from Rust by i18n::apply, so the UI never
// hardcodes text and a new language needs no change here.
export global Labels {
    in property <string> log;
    in property <string> settings;

    in property <string> whats-new;
    in property <string> update-now;
    in property <string> restart-app;
    in property <string> dismiss;

    in property <string> state-connected;
    in property <string> state-connecting;
    in property <string> state-disconnecting;
    in property <string> state-error;
    in property <string> state-idle;
    in property <string> choose-profile;
    in property <string> vpn-address;
    in property <string> server;
    in property <string> received;
    in property <string> sent;

    in property <string> connect;
    in property <string> disconnect;

    in property <string> profiles;
    in property <string> import-label;
    in property <string> import-profiles;
    in property <string> password-saved;
    in property <string> forget-password;
    in property <string> remove;
    in property <string> search-placeholder;

    in property <string> empty-title;
    in property <string> empty-hint;

    in property <string> check-updates;
    in property <string> checking;

    in property <string> theme;
    in property <string> dark;
    in property <string> light;
    in property <string> language;
    in property <string> close;

    in property <string> remove-body-saved;
    in property <string> remove-body;
    in property <string> cancel;

    in property <string> password-saved-hint;
    in property <string> username;
    in property <string> password;
    in property <string> code;
    in property <string> remember-password;
    in property <string> change-password;
    in property <string> sign-in;
    in property <string> continue-button;

    in property <string> log-title;
    in property <string> connection-log;
    in property <string> copy-all;
    in property <string> save;
    in property <string> clear;
    in property <string> log-empty;
}

// TimeWeb Cloud design tokens. Every colour, radius and shadow in the app comes
// from here, so the palette can be changed in one place.
export global Theme {
    // Slint takes a single family, not a CSS fallback list. Swap this line when
    // the Stem licence arrives; the system font covers the gap until then.
    out property <string> font-family: "Inter";

    in-out property <bool> dark: true;

    out property <color> accent: #454CEE;
    out property <color> accent-hover: #1D20EE;
    // Indigo wash for selected rows and banners.
    out property <color> accent-soft: dark ? #242B47 : #E4E6FD;

    out property <color> bg: dark ? #050C26 : #F5F6FE;
    out property <brush> window-bg: dark ? @linear-gradient(180deg, #181F38 0%, #050C26 100%) : #F5F6FE;
    out property <color> surface: dark ? #181F38 : #FFFFFF;
    out property <color> line: dark ? #242B47 : #E4E6FD;
    out property <color> tint: dark ? #242B47 : #D8DBFA;

    out property <color> text: dark ? #FFFFFF : #050C26;
    out property <color> text-muted: dark ? #969CAF : #646B85;

    out property <color> success: #1CC14D;
    out property <color> error: #EA4335;
    out property <color> warning: #FBBC05;

    // 0 12px 32px rgba(37,23,121,0.06): soft and violet, never black.
    out property <color> shadow: #2517790F;
    out property <length> shadow-blur: 32px;

    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 24px;
    out property <length> radius-2xl: 32px;

    out property <duration> motion: 200ms;
}

// Lets Tab reach a clickable element and Enter or Space activate it.
// Mouse clicks don't take focus, so the focus ring only shows for keyboard use.
component ActivationScope inherits FocusScope {
    callback activated();
    focus-on-click: false;
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.activated();
            return accept;
        }
        reject
    }
}

// A dimmed overlay with a centered card. Escape cancels it.
component Modal inherits Rectangle {
    callback cancel();
    background: #050C2699;
    TouchArea { }

    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(400px, root.width - 32px);
            height: card.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-xl;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: 12px;

            card := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                @children
            }
        }
    }
}

component BigButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: true;
    in property <length> font-size: 16px;
    callback clicked();

    min-height: 48px;
    border-radius: Theme.radius-md;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary
        ? (area.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : (area.has-hover && root.enabled ? Theme.tint : Theme.surface);
    border-width: focus.has-focus ? 2px : root.primary ? 0 : 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.line;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-in-out; }

    Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 600;
        color: root.primary ? #FFFFFF : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Link inherits Text {
    in property <bool> enabled: true;
    callback clicked();
    color: !root.enabled ? Theme.text-muted : link-area.has-hover ? Theme.accent-hover : Theme.accent;
    font-weight: 600;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    animate color { duration: Theme.motion; easing: ease-in-out; }

    if focus.has-focus: Rectangle {
        x: -4px;
        y: -2px;
        width: parent.width + 8px;
        height: parent.height + 4px;
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.accent;
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    link-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A text field in the app's own style, so both themes look the same.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password: false;
    in-out property <string> text;
    callback accepted();

    height: 44px;
    border-radius: Theme.radius-md;
    background: Theme.dark ? Theme.bg : Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    forward-focus: input;

    animate border-color { duration: Theme.motion; easing: ease-in-out; }

    public function focus-input() {
        input.focus();
    }

    // Clicks on the padding focus the field too; the input keeps its own clicks.
    TouchArea {
        clicked => {
            input.focus();
        }
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        font-size: 15px;
        color: Theme.text;
        input-type: root.password ? InputType.password : InputType.text;
        text <=> root.text;
        accepted => {
            root.accepted();
        }
    }

    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 15px;
        color: Theme.text-muted;
        text: root.placeholder;
    }
}

component Check inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    spacing: 8px;
    height: 24px;
    alignment: start;

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.line;
        background: root.checked ? Theme.accent : transparent;

        animate background { duration: Theme.motion; easing: ease-in-out; }

        if root.checked: Path {
            x: 4px;
            y: 5px;
            width: 10px;
            height: 8px;
            commands: "M 0 4 L 3.5 7.5 L 10 0";
            stroke: #FFFFFF;
            stroke-width: 2px;
            fill: transparent;
        }
    }

    Text {
        text: root.text;
        font-size: 14px;
        color: Theme.text;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

component Stat inherits VerticalLayout {    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-muted;
    }

    Text {
        text: root.value;
        font-size: 16px;
        font-weight: 600;
        color: Theme.text;
        overflow: elide;
    }
}

component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <bool> connected;
    in property <bool> can-remove;
    in property <bool> saved-password;
    callback clicked();
    callback remove();
    callback forget-password();

    height: 56px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.accent-soft : row-area.has-hover ? Theme.tint : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.accent;

    animate background { duration: Theme.motion; easing: ease-in-out; }

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                font-size: 15px;
                font-weight: root.selected ? 600 : 400;
                color: Theme.text;
                overflow: elide;
            }

            // The actions sit on this line so they don't squeeze long names.
            if root.saved-password || (root.selected && root.can-remove): HorizontalLayout {
                spacing: 14px;
                Text {
                    text: root.saved-password ? Labels.password-saved : "";
                    font-size: 12px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.selected && root.saved-password: Link {
                    text: Labels.forget-password;
                    font-size: 12px;
                    clicked => {
                        root.forget-password();
                    }
                }

                if root.selected && root.can-remove: Link {
                    text: Labels.remove;
                    font-size: 12px;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }

        if root.connected: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.success;
        }
    }
}

export component AppWindow inherits Window {
    title: "VPNdeck";
    icon: @image-url("../assets/vpndeck-256.png");
    preferred-width: 440px;
    preferred-height: 720px;
    min-width: 360px;
    min-height: 560px;
    default-font-size: 15px;
    default-font-family: Theme.font-family;
    background: Theme.window-bg;

    in property <[ProfileInfo]> profiles;
    // How many profiles exist, which is not the same as the filtered list above.
    in property <int> profile-count;
    in-out property <int> selected: -1;
    // Index of the profile with a running openvpn process, or -1.
    in property <int> active: -1;
    // Index of the profile the status fields below describe, kept after it stops.
    in property <int> status-for: -1;
    in property <ConnState> conn-state: ConnState.idle;
    in property <string> status-text;
    in property <string> local-ip: "—";
    in property <string> remote: "—";
    in property <string> rx: "—";
    in property <string> tx: "—";
    in property <string> duration: "—";
    in property <string> notice;
    // Whether the notice reports a failure, which colours the banner.
    in property <bool> notice-error: false;
    in-out property <string> search-query;
    // "en" or "ru", so the language picker knows which button is active.
    in property <string> lang;

    in property <bool> auth-visible;
    in property <bool> auth-needs-username: true;
    in property <bool> auth-needs-password: true;
    in property <bool> auth-needs-code: false;
    // The challenge text the server sent, e.g. "Enter code".
    in property <string> auth-challenge-text;
    // The password comes from the keyring, so only the code is asked for.
    in property <bool> auth-password-saved;
    in property <string> auth-title;
    in property <string> auth-error;
    in-out property <string> auth-username;
    in-out property <string> auth-password;
    in-out property <string> auth-code;
    in-out property <bool> auth-remember;
    // Index of the profile whose removal is waiting for confirmation, or -1.
    in-out property <int> confirm-remove: -1;
    // The name and keyring state of that profile, so the dialog doesn't have to
    // index into the filtered list.
    in property <string> confirm-title;
    in property <bool> confirm-saved-password;
    in-out property <bool> settings-visible: false;

    in property <string> version;
    in property <UpdateState> update-state: UpdateState.idle;
    // Shown in the banner while an update is available or being installed.
    in property <string> update-text;
    // Shown under the version, e.g. "You're up to date".
    in property <string> update-note;
    in property <float> update-progress;

    callback check-updates();
    callback install-update();
    callback open-release-notes();
    callback restart-app();
    callback dismiss-update();

    callback import-profile();
    callback remove-profile(int);
    callback forget-password(int);
    callback select-profile(int);
    callback request-remove(int);
    callback connect(int);
    callback disconnect();
    callback submit-auth(string, string, string);
    callback cancel-auth();
    callback change-password();
    callback show-log();
    callback set-theme(bool);
    callback set-language(string);
    callback search-changed(string);

    property <bool> has-selection: root.selected >= 0 && root.selected < root.profile-count;
    property <bool> busy: root.active >= 0;
    property <bool> can-check: root.update-state == UpdateState.idle || root.update-state == UpdateState.failed;
    // While a connection runs, the card always describes it, whichever row is selected.
    property <bool> shows-status: root.busy || (root.has-selection && root.selected == root.status-for);
    property <ConnState> shown-state: root.shows-status ? root.conn-state : ConnState.idle;
    // The name of the profile the card describes, filled in from Rust because the
    // list above is filtered and its indices don't match the store.
    in property <string> card-name;
    property <color> state-color: root.shown-state == ConnState.connected ? Theme.success
        : root.shown-state == ConnState.error ? Theme.error
        : root.shown-state == ConnState.idle ? Theme.text-muted
        : Theme.warning;

    changed search-query => {
        root.search-changed(root.search-query);
    }

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 10px;
            Image {
                source: @image-url("../assets/shield.svg");
                colorize: Theme.accent;
                width: 28px;
                height: 28px;
            }

            Text {
                text: "VPNdeck";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Link {
                text: Labels.log;
                font-size: 14px;
                vertical-alignment: center;
                clicked => {
                    root.show-log();
                }
            }

            Link {
                text: Labels.settings;
                font-size: 14px;
                vertical-alignment: center;
                clicked => {
                    root.settings-visible = true;
                }
            }
        }

        if root.update-state != UpdateState.idle && root.update-state != UpdateState.checking: Rectangle {
            border-radius: Theme.radius-lg;
            background: root.update-state == UpdateState.failed ? Theme.error.transparentize(0.88) : Theme.accent-soft;
            min-height: banner.preferred-height;
            banner := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    wrap: word-wrap;
                    color: Theme.text;
                    text: root.update-text;
                }

                if root.update-state == UpdateState.downloading: Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.line;
                    Rectangle {
                        width: parent.width * root.update-progress;
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.accent;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 16px;
                    if root.update-state == UpdateState.available: Link {
                        text: Labels.whats-new;
                        font-size: 14px;
                        vertical-alignment: center;
                        clicked => {
                            root.open-release-notes();
                        }
                    }

                    if root.update-state == UpdateState.available: BigButton {
                        text: Labels.update-now;
                        font-size: 14px;
                        min-height: 40px;
                        width: 130px;
                        clicked => {
                            root.install-update();
                        }
                    }

                    if root.update-state == UpdateState.done: BigButton {
                        text: Labels.restart-app;
                        font-size: 14px;
                        min-height: 40px;
                        width: 170px;
                        clicked => {
                            root.restart-app();
                        }
                    }

                    if root.update-state == UpdateState.failed: Link {
                        text: Labels.dismiss;
                        font-size: 14px;
                        clicked => {
                            root.dismiss-update();
                        }
                    }
                }
            }
        }

        // First run: nothing to connect to yet, so the import is the only action.
        if root.profile-count == 0: Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: 12px;
            min-height: empty-card.preferred-height;
            empty-card := VerticalLayout {
                padding: 28px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: Theme.radius-lg;
                        background: Theme.accent-soft;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../assets/shield.svg");
                            colorize: Theme.accent;
                            width: 32px;
                            height: 32px;
                        }
                    }
                }

                Text {
                    text: Labels.empty-title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: Labels.empty-hint;
                    font-size: 14px;
                    wrap: word-wrap;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }

                BigButton {
                    text: Labels.import-profiles;
                    font-size: 15px;
                    min-height: 44px;
                    clicked => {
                        root.import-profile();
                    }
                }
            }
        }

        // Status card
        if root.profile-count > 0: Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: 12px;
            min-height: card.preferred-height;
            card := VerticalLayout {
                padding: 20px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: Theme.radius-md;
                        background: root.state-color.transparentize(0.88);
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../assets/shield.svg");
                            colorize: root.state-color;
                            width: 28px;
                            height: 28px;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            font-size: 22px;
                            font-weight: 700;
                            color: root.shown-state == ConnState.idle ? Theme.text : root.state-color;
                            text: root.shown-state == ConnState.connected ? Labels.state-connected
                                : root.shown-state == ConnState.connecting ? Labels.state-connecting
                                : root.shown-state == ConnState.disconnecting ? Labels.state-disconnecting
                                : root.shown-state == ConnState.error ? Labels.state-error
                                : Labels.state-idle;
                        }

                        Text {
                            font-size: 14px;
                            wrap: word-wrap;
                            color: Theme.text-muted;
                            text: root.shown-state == ConnState.connected ? root.card-name + "  ·  " + root.duration
                                : root.shown-state == ConnState.idle ? (root.card-name != "" ? root.card-name : Labels.choose-profile)
                                : root.status-text;
                        }
                    }
                }

                if root.shown-state == ConnState.connected: GridLayout {
                    spacing: 12px;
                    Row {
                        Stat {
                            label: Labels.vpn-address;
                            value: root.local-ip;
                        }

                        Stat {
                            label: Labels.server;
                            value: root.remote;
                        }
                    }

                    Row {
                        Stat {
                            label: Labels.received;
                            value: root.rx;
                        }

                        Stat {
                            label: Labels.sent;
                            value: root.tx;
                        }
                    }
                }
            }
        }

        if root.profile-count > 0: BigButton {
            primary: !root.busy;
            text: !root.busy ? Labels.connect
                : root.conn-state == ConnState.disconnecting ? Labels.state-disconnecting
                : Labels.disconnect;
            enabled: root.busy ? root.conn-state != ConnState.disconnecting : root.has-selection;
            clicked => {
                if root.busy {
                    root.disconnect();
                } else {
                    root.connect(root.selected);
                }
            }
        }

        if root.profile-count > 0: HorizontalLayout {
            padding-top: 4px;
            spacing: 8px;
            Text {
                text: Labels.profiles;
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
            }

            Text {
                text: "(" + root.profile-count + ")";
                font-size: 14px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Link {
                text: Labels.import-label;
                font-size: 14px;
                vertical-alignment: center;
                clicked => {
                    root.import-profile();
                }
            }
        }

        // Only worth the space once the list is long enough to scan.
        if root.profile-count > 4: Field {
            placeholder: Labels.search-placeholder;
            text <=> root.search-query;
        }

        if root.notice != "": Rectangle {
            border-radius: Theme.radius-md;
            background: root.notice-error ? Theme.error.transparentize(0.9) : Theme.accent-soft;
            min-height: notice-text.preferred-height;
            notice-text := VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                Text {
                    text: root.notice;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: root.notice-error ? Theme.error : Theme.text;
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            for profile[i] in root.profiles: VerticalLayout {
                padding-bottom: 6px;
                ProfileRow {
                    name: profile.name;
                    saved-password: profile.saved-password;
                    selected: profile.index == root.selected;
                    connected: profile.index == root.active && root.conn-state == ConnState.connected;
                    can-remove: profile.index != root.active;
                    clicked => {
                        root.select-profile(profile.index);
                    }
                    remove => {
                        root.request-remove(profile.index);
                    }
                    forget-password => {
                        root.forget-password(profile.index);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                Text {
                    text: "VPNdeck " + root.version;
                    font-size: 12px;
                    color: Theme.text-muted;
                    horizontal-stretch: 1;
                }

                Link {
                    font-size: 12px;
                    enabled: root.can-check;
                    text: root.update-state == UpdateState.checking ? Labels.checking : Labels.check-updates;
                    clicked => {
                        root.check-updates();
                    }
                }
            }

            if root.update-note != "": Text {
                text: root.update-note;
                font-size: 12px;
                wrap: word-wrap;
                color: Theme.text-muted;
            }
        }
    }

    if root.settings-visible: Modal {
        cancel => {
            root.settings-visible = false;
        }

        Text {
            text: Labels.settings;
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
        }

        Text {
            text: Labels.theme;
            font-size: 14px;
            color: Theme.text-muted;
        }

        HorizontalLayout {
            spacing: 10px;
            BigButton {
                primary: Theme.dark;
                text: Labels.dark;
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.set-theme(true);
                }
            }

            BigButton {
                primary: !Theme.dark;
                text: Labels.light;
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.set-theme(false);
                }
            }
        }

        Text {
            text: Labels.language;
            font-size: 14px;
            color: Theme.text-muted;
        }

        HorizontalLayout {
            spacing: 10px;
            BigButton {
                primary: root.lang == "en";
                text: "English";
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.set-language("en");
                }
            }

            BigButton {
                primary: root.lang == "ru";
                text: "Русский";
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.set-language("ru");
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            padding-top: 4px;
            BigButton {
                primary: false;
                text: Labels.close;
                font-size: 15px;
                min-height: 44px;
                width: 110px;
                clicked => {
                    root.settings-visible = false;
                }
            }
        }
    }

    if root.confirm-remove >= 0: Modal {
        cancel => {
            root.confirm-remove = -1;
        }

        Text {
            text: root.confirm-title;
            wrap: word-wrap;
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
        }

        Text {
            text: root.confirm-saved-password ? Labels.remove-body-saved : Labels.remove-body;
            wrap: word-wrap;
            color: Theme.text-muted;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            BigButton {
                primary: false;
                text: Labels.cancel;
                font-size: 15px;
                min-height: 44px;
                init => {
                    self.focus();
                }
                clicked => {
                    root.confirm-remove = -1;
                }
            }

            BigButton {
                text: Labels.remove;
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.remove-profile(root.confirm-remove);
                    root.confirm-remove = -1;
                }
            }
        }
    }

    if root.auth-visible: Modal {
        cancel => {
            root.cancel-auth();
        }

        Text {
            text: root.auth-title;
            wrap: word-wrap;
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
        }

        if root.auth-password-saved: Text {
            text: Labels.password-saved-hint;
            wrap: word-wrap;
            color: Theme.text-muted;
        }

        if root.auth-needs-username: Field {
            placeholder: Labels.username;
            text <=> root.auth-username;
            init => {
                if root.auth-username == "" {
                    self.focus-input();
                }
            }
            accepted => {
                password-edit.focus-input();
            }
        }

        password-edit := Field {
            visible: root.auth-needs-password;
            placeholder: Labels.password;
            password: true;
            text <=> root.auth-password;
            init => {
                if !root.auth-needs-username || root.auth-username != "" {
                    self.focus-input();
                }
            }
            accepted => {
                if root.auth-needs-code {
                    code-edit.focus-input();
                } else {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }

        VerticalLayout {
            visible: root.auth-needs-code;
            spacing: 6px;
            if root.auth-challenge-text != "": Text {
                text: root.auth-challenge-text;
                wrap: word-wrap;
                color: Theme.text-muted;
            }

            code-edit := Field {
                placeholder: Labels.code;
                password: true;
                text <=> root.auth-code;
                init => {
                    if !root.auth-needs-password {
                        self.focus-input();
                    }
                }
                accepted => {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }

        if root.auth-needs-password: Check {
            text: Labels.remember-password;
            checked <=> root.auth-remember;
        }

        if root.auth-password-saved: Link {
            text: Labels.change-password;
            clicked => {
                root.change-password();
            }
        }

        if root.auth-error != "": Text {
            text: root.auth-error;
            wrap: word-wrap;
            color: Theme.error;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            BigButton {
                primary: false;
                text: Labels.cancel;
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.cancel-auth();
                }
            }

            BigButton {
                text: root.auth-needs-password ? Labels.sign-in : Labels.continue-button;
                font-size: 15px;
                min-height: 44px;
                clicked => {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }
    }
}

export component LogWindow inherits Window {
    title: Labels.log-title;
    icon: @image-url("../assets/vpndeck-256.png");
    preferred-width: 760px;
    preferred-height: 460px;
    default-font-size: 15px;
    default-font-family: Theme.font-family;
    background: Theme.bg;

    in property <[string]> lines;
    in property <int> count;
    callback copy-all();
    callback save();
    callback clear();

    // Whether new lines scroll into view; off while the user reads further up.
    property <bool> follow: true;

    changed count => {
        if root.follow {
            log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
        }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 18px;
            Text {
                text: Labels.connection-log;
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Link {
                text: Labels.copy-all;
                font-size: 14px;
                vertical-alignment: center;
                enabled: root.lines.length > 0;
                clicked => {
                    root.copy-all();
                }
            }

            Link {
                text: Labels.save;
                font-size: 14px;
                vertical-alignment: center;
                enabled: root.lines.length > 0;
                clicked => {
                    root.save();
                }
            }

            Link {
                text: Labels.clear;
                font-size: 14px;
                vertical-alignment: center;
                enabled: root.lines.length > 0;
                clicked => {
                    root.clear();
                }
            }
        }

        if root.lines.length == 0: Text {
            color: Theme.text-muted;
            text: Labels.log-empty;
            wrap: word-wrap;
        }

        log-view := ListView {
            vertical-stretch: 1;
            scrolled => {
                root.follow = self.content-y <= self.visible-height - self.content-height + 24px;
            }
            for line in root.lines: Text {
                text: line;
                wrap: word-wrap;
                font-family: "monospace";
                font-size: 12px;
                color: Theme.text;
            }
        }
    }
}
