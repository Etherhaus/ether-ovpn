import { ListView } from "std-widgets.slint";

export enum ConnState { idle, connecting, connected, disconnecting, error }

export struct ProfileInfo {
    // Index in the store, so a filtered list still maps back to the right profile.
    index: int,
    name: string,
    saved-password: bool,
    // host:port from the profile's remote line, shown before connecting.
    remote: string,
    // One or two letters for the row's avatar.
    initials: string,
}

// One line of openvpn output. level: 0 ordinary, 1 warning, 2 error.
export struct LogLine {
    text: string,
    level: int,
}

// One line of a profile, with the number shown next to it.
export struct ProfileLine {
    number: int,
    text: string,
    // A directive that makes openvpn run a program, which it does as root.
    risky: bool,
}

// One result of the pre-connect check. state: 0 passed, 1 failed, 2 skipped.
export struct CheckLine {
    label: string,
    detail: string,
    state: int,
}

export enum UpdateState { idle, checking, available, downloading, installing, done, failed }

// Every user-visible string. Filled from Rust by i18n::apply, so the UI never
// hardcodes text and a new language needs no change here.
export global Labels {
    in property <string> log;
    in property <string> settings;

    in property <string> whats-new;
    in property <string> update-now;
    in property <string> restart-app;
    in property <string> dismiss;

    in property <string> state-connected;
    in property <string> state-connecting;
    in property <string> state-disconnecting;
    in property <string> state-error;
    in property <string> state-idle;
    in property <string> choose-profile;
    in property <string> vpn-address;
    in property <string> server;
    in property <string> received;
    in property <string> sent;

    in property <string> connect;
    in property <string> disconnect;

    in property <string> profiles;
    in property <string> import-label;
    in property <string> import-profiles;
    in property <string> password-saved;
    in property <string> forget-password;
    in property <string> remove;
    in property <string> search-placeholder;
    in property <string> search-empty;

    in property <string> add-title;
    in property <string> add-files;
    in property <string> add-paste;
    in property <string> add-url;
    in property <string> add-url-placeholder;
    in property <string> add-hint;

    in property <string> rename-title;
    in property <string> rename;
    in property <string> rename-empty;
    in property <string> rename-taken;

    in property <string> view;
    in property <string> view-title;
    in property <string> view-check;
    in property <string> view-checking;
    in property <string> view-copy;
    in property <string> view-close;
    in property <string> view-risky;
    in property <string> check-file;
    in property <string> check-remote;
    in property <string> check-files;
    in property <string> check-dns;
    in property <string> check-port;
    in property <string> check-remote-missing;
    in property <string> check-udp-skipped;
    in property <string> check-passed;
    in property <string> check-failed;

    in property <string> empty-title;
    in property <string> empty-hint;

    in property <string> check-updates;
    in property <string> checking;

    in property <string> theme;
    in property <string> dark;
    in property <string> light;
    in property <string> system;
    in property <string> language;
    in property <string> startup;
    in property <string> autostart;
    in property <string> auto-connect;
    in property <string> notifications;
    in property <string> notify-on;
    in property <string> window;
    in property <string> frame;
    in property <string> close;

    in property <string> remove-body-saved;
    in property <string> remove-body;
    in property <string> cancel;

    in property <string> password-saved-hint;
    in property <string> username;
    in property <string> password;
    in property <string> code;
    in property <string> show-password;
    in property <string> remember-password;
    in property <string> change-password;
    in property <string> sign-in;
    in property <string> continue-button;

    in property <string> log-title;
    in property <string> connection-log;
    in property <string> copy-all;
    in property <string> save;
    in property <string> clear;
    in property <string> log-empty;
    in property <string> log-filter-placeholder;
    in property <string> log-nothing-found;
    in property <string> diagnostics;
}

// Design tokens of the EtherOS look: coral accent, Adwaita Sans for text,
// JetBrains Mono for numbers and labels, niri window chrome. Every colour,
// radius and shadow in the app comes from here.
export global Theme {
    out property <string> font-family: "Adwaita Sans";
    out property <string> mono: "JetBrains Mono";

    in-out property <bool> dark: true;

    out property <color> bg: dark ? #16161a : #f6f5f4;
    // The page is lit from above, like the site's --bg-glow.
    out property <brush> bg-glow: dark
        ? @linear-gradient(180deg, #232329 0%, #1b1b1f 45%, #16161a 100%)
        : @linear-gradient(180deg, #ffffff 0%, #f6f5f4 55%, #efeeec 100%);
    out property <color> surface: dark ? #242428 : #ffffff;
    out property <color> surface-2: dark ? #303036 : #f0efed;
    out property <color> surface-3: dark ? #1b1b1f : #faf9f8;
    // Fields sit below the card they are on, in both themes.
    out property <color> field: dark ? #1b1b1f : #f0efed;
    out property <color> line: dark ? #FFFFFF1A : #0000001F;
    out property <color> line-soft: dark ? #FFFFFF12 : #00000014;
    out property <color> text: dark ? #f6f5f4 : #1b1b1f;
    out property <color> text-2: dark ? #FFFFFFE0 : #2b2b31;
    out property <color> dim: dark ? #8b8b93 : #5e5e66;
    out property <color> dim-2: dark ? #FFFFFF8C : #6b6b73;

    // #d9531e on white is 4.03:1, so light-theme text uses accent-ink instead.
    out property <color> accent: dark ? #fb8762 : #d9531e;
    out property <color> accent-ink: dark ? #fb8762 : #b8431a;
    out property <color> accent-strong: dark ? #fb8762 : #b8431a;
    out property <color> on-accent: dark ? #16161a : #ffffff;
    out property <color> accent-soft: dark ? #FB87621F : #D9531E1A;
    out property <color> accent-soft-2: dark ? #FB876242 : #D9531E33;
    out property <color> accent-line: dark ? #FB876273 : #D9531E66;
    out property <color> accent-glow: dark ? #FB876247 : #D9531E2E;

    // No green anywhere: connected is coral, a warning is yellow, a failure red.
    out property <color> warn: dark ? #f8e45c : #8a6d00;
    out property <color> bad: dark ? #f66151 : #b3261e;
    out property <color> info: dark ? #62a0ea : #1c5fb0;

    // The 1px light line along the top edge of a card.
    out property <color> highlight: dark ? #FFFFFF12 : #FFFFFFE6;
    out property <color> shadow: dark ? #0000008C : #0000001F;
    out property <length> shadow-blur: 30px;

    out property <length> radius-win: 26px;
    out property <length> radius-card: 16px;
    out property <length> radius-sm: 12px;

    out property <duration> motion: 160ms;
}

// A solid card: hairline border, a light line along the top edge, and a shadow.
// The highlight is inset past the corner radius so it never pokes out.
component Card inherits Rectangle {
    in property <length> radius: Theme.radius-card;
    in property <color> fill: Theme.surface;
    in property <color> edge: Theme.line;

    background: root.fill;
    border-radius: root.radius;
    border-width: 1px;
    border-color: root.edge;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: 8px;

    Rectangle {
        x: root.radius;
        y: 1px;
        width: parent.width - root.radius * 2;
        height: 1px;
        background: Theme.highlight;
    }
}

// Lets Tab reach a clickable element and Enter or Space activate it.
// Mouse clicks don't take focus, so the focus ring only shows for keyboard use.
component ActivationScope inherits FocusScope {
    callback activated();
    focus-on-click: false;
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.activated();
            return accept;
        }
        reject
    }
}

// The app icon, in the variant that belongs to the current theme.
component Logo inherits Image {
    in property <length> size: 20px;
    width: root.size;
    height: root.size;
    source: Theme.dark ? @image-url("../assets/ether.svg") : @image-url("../assets/ether-light.svg");
}

// The mark from the app icon, on its own: the shield outline and the keyhole in
// the accent colour, with no tile behind them.
//
// The tile is an app icon: at 24px in a title bar it turns into a dark square
// that reads as a smudge, and the icon's 11-unit outline thins out to a hairline.
// The bare mark keeps the icon's shape and polarity — outline plus keyhole — and
// stays legible down to 20px.
component Shield inherits Rectangle {
    in property <length> size: 24px;
    in property <color> tint: Theme.accent;

    width: root.size;
    height: root.size;
    background: transparent;

    // The icon's 512-unit grid, cropped to the shield (116..396 by 92..404) plus
    // room for the outline, and squared off around the mark's centre.
    //
    // Both paths carry the same stroke width: Slint fits a path into the box
    // minus its stroke, so a keyhole without one would be scaled differently
    // from the outline it sits in.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 85;
        viewbox-y: 77;
        viewbox-width: 342;
        viewbox-height: 342;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-join: round;
        commands: "M256 92 C 302 122 346 138 396 142 C 396 236 376 330 256 404 C 136 330 116 236 116 142 C 166 138 210 122 256 92 Z";
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 85;
        viewbox-y: 77;
        viewbox-width: 342;
        viewbox-height: 342;
        fill: root.tint;
        stroke: transparent;
        stroke-width: 1.5px;
        commands: "M256 202 a 42 42 0 0 1 42 42 c 0 17 -10 31 -24 38 l 16 64 q 2 10 -8 10 h -52 q -10 0 -8 -10 l 16 -64 c -14 -7 -24 -21 -24 -38 a 42 42 0 0 1 42 -42 z";
    }
}

// A 12px line glyph: 0 log, 1 settings, 2 close.
component Glyph inherits Path {
    in property <int> kind: 0;
    in property <color> tint: Theme.text-2;

    width: 12px;
    height: 12px;
    stroke: root.tint;
    stroke-width: 1.5px;
    fill: transparent;
    commands: root.kind == 0
        ? "M 0 1.5 L 11 1.5 M 0 6 L 11 6 M 0 10.5 L 11 10.5"
        : root.kind == 1
        ? "M 0 3 L 11 3 M 0 9 L 11 9 M 3.5 0.5 L 3.5 5.5 M 7.5 6.5 L 7.5 11.5"
        : "M 0.5 0.5 L 10.5 10.5 M 10.5 0.5 L 0.5 10.5";
}

// A round 26px button for the title bar.
component IconButton inherits Rectangle {
    in property <int> glyph: 0;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: area.has-hover && root.enabled ? Theme.accent-soft : Theme.line-soft;
    border-width: 1px;
    border-color: area.has-hover && root.enabled ? Theme.accent-line : transparent;
    opacity: root.enabled ? 1 : 0.4;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    Glyph {
        kind: root.glyph;
        tint: area.has-hover && root.enabled ? Theme.accent-ink : Theme.text-2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A quiet action label in the mono face, the way the site writes its labels.
component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent-ink;
    callback clicked();

    height: 26px;
    border-radius: Theme.radius-sm;
    background: area.has-hover && root.enabled ? Theme.accent-soft : transparent;
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            color: area.has-hover && root.enabled ? Theme.accent-ink : root.tint;
            vertical-alignment: center;
        }
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The niri title bar: a mono spec on the left, the title in the middle, round
// buttons on the right. The 1px accent line under it is the brand's tell.
component TitleBar inherits Rectangle {
    in property <string> title;
    in property <string> spec: "";
    in property <string> spec-value: "";
    in property <color> spec-color: Theme.accent-ink;
    in property <bool> show-logo: false;
    in property <bool> show-actions: false;
    callback close();
    callback log();
    callback settings();

    height: 40px;
    background: Theme.surface-2;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.accent-line 50%, transparent 100%);
    }

    HorizontalLayout {
        x: 16px;
        height: parent.height;
        spacing: 8px;
        alignment: start;
        // Without this the fixed-size mark is stretched to the bar height and
        // pinned to its top edge, where the window frame clips it.
        cross-axis-alignment: center;

        if root.show-logo: Shield {
            size: 24px;
        }

        if root.spec != "": Text {
            text: root.spec;
            font-family: Theme.mono;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.dim;
            vertical-alignment: center;
        }

        if root.spec-value != "": Text {
            text: root.spec-value;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
            color: root.spec-color;
            vertical-alignment: center;
        }
    }

    Text {
        x: 104px;
        width: parent.width - 208px;
        height: parent.height;
        text: root.title;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: parent.width - self.width - 12px;
        height: parent.height;
        spacing: 6px;
        alignment: end;
        cross-axis-alignment: center;

        if root.show-actions: IconButton {
            glyph: 0;
            label: Labels.log;
            clicked => {
                root.log();
            }
        }

        if root.show-actions: IconButton {
            glyph: 1;
            label: Labels.settings;
            clicked => {
                root.settings();
            }
        }

        IconButton {
            glyph: 2;
            label: Labels.close;
            clicked => {
                root.close();
            }
        }
    }
}

// A dimmed overlay with a centered window of its own. Escape cancels it.
component Modal inherits Rectangle {
    in property <string> title;
    callback cancel();

    background: #000000B8;
    TouchArea { }

    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(400px, root.width - 28px);
            height: card.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-win;
            border-width: 3px;
            border-color: Theme.accent;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 18px;
            clip: true;

            card := VerticalLayout {
                TitleBar {
                    title: root.title;
                    close => {
                        root.cancel();
                    }
                }

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    @children
                }
            }
        }
    }
}

export enum ButtonKind { solid, outline, ghost }

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <ButtonKind> kind: ButtonKind.outline;
    in property <length> font-size: 14px;
    callback clicked();

    min-height: 42px;
    border-radius: Theme.radius-sm;
    opacity: root.enabled ? 1 : 0.4;
    background: root.kind == ButtonKind.solid
        ? (area.has-hover && root.enabled ? Theme.accent : Theme.accent-strong)
        : root.kind == ButtonKind.outline
        ? (area.has-hover && root.enabled ? Theme.accent-soft-2 : Theme.accent-soft)
        : (area.has-hover && root.enabled ? Theme.accent-soft : transparent);
    border-width: root.kind == ButtonKind.solid ? 0 : root.kind == ButtonKind.outline ? 2px : 1px;
    border-color: root.kind == ButtonKind.outline ? Theme.accent : root.kind == ButtonKind.ghost ? Theme.line : transparent;
    drop-shadow-color: focus.has-focus ? Theme.accent-glow : transparent;
    drop-shadow-blur: 14px;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 700;
        color: root.kind == ButtonKind.solid ? Theme.on-accent
            : root.kind == ButtonKind.outline ? Theme.accent-ink
            : Theme.text-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Link inherits Text {
    in property <bool> enabled: true;
    callback clicked();
    color: !root.enabled ? Theme.dim : link-area.has-hover ? Theme.accent : Theme.accent-ink;
    font-weight: 600;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    animate color { duration: Theme.motion; easing: ease-in-out; }

    if focus.has-focus: Rectangle {
        x: -4px;
        y: -2px;
        width: parent.width + 8px;
        height: parent.height + 4px;
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.accent;
    }

    focus := ActivationScope {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    link-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A text field in the app's own style, so both themes look the same.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password: false;
    // Shows a password field's contents in plain text.
    in property <bool> reveal: false;
    in-out property <string> text;
    callback accepted();

    height: 42px;
    border-radius: Theme.radius-sm;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    // The halo is a shadow rather than a second rectangle, so it can sit behind
    // the field without being clipped by it.
    drop-shadow-color: input.has-focus ? Theme.accent-glow : transparent;
    drop-shadow-blur: 14px;
    forward-focus: input;

    animate border-color { duration: Theme.motion; easing: ease-out; }
    animate drop-shadow-color { duration: Theme.motion; easing: ease-out; }

    public function focus-input() {
        input.focus();
    }

    // Clicks on the padding focus the field too; the input keeps its own clicks.
    TouchArea {
        clicked => {
            input.focus();
        }
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        font-size: 13.5px;
        color: Theme.text;
        input-type: root.password && !root.reveal ? InputType.password : InputType.text;
        // The placeholder is a separate Text, so the field needs its own label.
        accessible-label: root.placeholder;
        text <=> root.text;
        accepted => {
            root.accepted();
        }
    }

    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 13.5px;
        color: Theme.dim;
        text: root.placeholder;
    }
}

// A checkbox. It inherits Rectangle rather than a layout: a TouchArea inside a
// layout gets no size of its own and would never see a click.
component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;

    height: 24px;
    background: transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.line;
            background: root.checked ? Theme.accent : transparent;

            animate background { duration: Theme.motion; easing: ease-out; }

            if root.checked: Path {
                x: 4px;
                y: 5px;
                width: 10px;
                height: 8px;
                commands: "M 0 4 L 3.5 7.5 L 10 0";
                stroke: Theme.on-accent;
                stroke-width: 2px;
                fill: transparent;
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text-2;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
        }
    }
}

// An on/off switch for the settings dialog.
component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Theme.accent : Theme.field;
    border-width: root.checked ? 0 : 1px;
    border-color: Theme.line;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        background: root.checked ? Theme.on-accent : Theme.dim;

        animate x { duration: Theme.motion; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A label on the left and a control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    height: 40px;
    cross-axis-alignment: center;
    Text {
        text: root.label;
        font-size: 13px;
        color: Theme.text-2;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    @children
}

// A number with a mono caption, the way the site writes its facts.
component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px;
    Text {
        text: root.label;
        font-family: Theme.mono;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 1px;
        color: Theme.dim;
    }

    Text {
        text: root.value;
        font-family: Theme.mono;
        font-size: 14px;
        font-weight: 700;
        color: Theme.text;
        overflow: elide;
    }
}

// One part of a segmented switch.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    border-radius: 9px;
    background: root.active ? Theme.accent-soft : transparent;
    border-width: root.active ? 1px : 0;
    border-color: root.active ? Theme.accent-line : transparent;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    Text {
        text: root.text;
        font-size: 12.5px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.accent-ink : Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Two or three choices. A third segment only appears when `third` is set.
component Segmented inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in property <string> third: "";
    in property <int> current: 0;
    callback picked(int);

    height: 38px;
    border-radius: Theme.radius-sm;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        Segment {
            horizontal-stretch: 1;
            text: root.first;
            active: root.current == 0;
            clicked => {
                root.picked(0);
            }
        }

        Segment {
            horizontal-stretch: 1;
            text: root.second;
            active: root.current == 1;
            clicked => {
                root.picked(1);
            }
        }

        if root.third != "": Segment {
            horizontal-stretch: 1;
            text: root.third;
            active: root.current == 2;
            clicked => {
                root.picked(2);
            }
        }
    }
}

// The profile's initials in a rounded square, so rows are easy to tell apart.
component Avatar inherits Rectangle {
    in property <string> initials;
    in property <bool> active: false;

    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: root.active ? Theme.accent-soft : Theme.field;
    border-width: 1px;
    border-color: root.active ? Theme.accent-line : Theme.line;

    animate background { duration: Theme.motion; easing: ease-out; }

    Text {
        text: root.initials;
        font-family: Theme.mono;
        font-size: 12px;
        font-weight: 700;
        color: root.active ? Theme.accent-ink : Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Download speed over the last few samples, as bars scaled to the peak.
component Sparkline inherits Rectangle {
    in property <[float]> samples;

    height: 28px;
    background: transparent;
    property <length> step: root.samples.length > 0 ? root.width / root.samples.length : 0px;

    for sample[i] in root.samples: Rectangle {
        x: i * root.step;
        width: max(1px, root.step - 2px);
        y: root.height - self.height;
        height: max(2px, sample * root.height);
        border-radius: 2px;
        background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent.transparentize(0.62) 100%);
    }
}

// A pill with a dot: the state of the tunnel, in the site's status-chip style.
component StatusChip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    in property <bool> pulse: false;
    in property <bool> pulse-on: true;

    height: 24px;
    // A pill hugs its label; without this the row would stretch it.
    width: row.preferred-width;
    border-radius: 999px;
    background: root.tint.transparentize(0.88);
    border-width: 1px;
    border-color: root.tint.transparentize(0.55);

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 11px;
        spacing: 7px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.tint;
            opacity: root.pulse ? (root.pulse-on ? 1 : 0.3) : 1;

            animate opacity { duration: 600ms; easing: ease-in-out; }
        }

        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            color: root.tint;
            vertical-alignment: center;
        }
    }
}

component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <string> remote;
    in property <string> initials;
    in property <bool> selected;
    in property <bool> connected;
    in property <bool> can-remove;
    in property <bool> saved-password;
    callback clicked();
    callback remove();
    callback forget-password();
    callback rename();
    callback view();

    min-height: 56px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-soft : row-area.has-hover ? Theme.surface-2 : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.accent-line;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Theme.motion; easing: ease-out; }

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 11px;
        cross-axis-alignment: center;

        Avatar {
            initials: root.initials;
            active: root.selected;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.name;
                font-size: 13.5px;
                font-weight: root.selected ? 700 : 500;
                color: Theme.text;
                overflow: elide;
            }

            if root.remote != "": Text {
                text: root.remote;
                font-family: Theme.mono;
                font-size: 10.5px;
                color: Theme.dim;
                overflow: elide;
            }

            // The actions sit on their own line so they don't squeeze long names.
            if root.selected: HorizontalLayout {
                spacing: 2px;
                padding-top: 3px;
                alignment: start;
                TextButton {
                    text: Labels.view;
                    clicked => {
                        root.view();
                    }
                }

                TextButton {
                    text: Labels.rename;
                    clicked => {
                        root.rename();
                    }
                }

                if root.saved-password: TextButton {
                    text: Labels.forget-password;
                    clicked => {
                        root.forget-password();
                    }
                }

                if root.can-remove: TextButton {
                    text: Labels.remove;
                    tint: Theme.bad;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }

        if root.connected: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
            drop-shadow-color: Theme.accent-glow;
            drop-shadow-blur: 8px;
        }
    }
}

export component AppWindow inherits Window {
    title: "Ether (ether-ovpn)";
    icon: @image-url("../assets/ether-256.png");
    preferred-width: 440px;
    preferred-height: 740px;
    min-width: 360px;
    min-height: 560px;
    default-font-size: 14px;
    default-font-family: Theme.font-family;
    // The 3px frame is the window background; the surface sits inside it.
    // Without the frame the surface fills the window and the corners are square.
    background: root.frame ? Theme.accent : Theme.bg-glow;
    // Width of the frame, so the surface can inset itself by exactly that much.
    property <length> frame-width: root.frame ? 3px : 0px;

    in property <[ProfileInfo]> profiles;
    // How many profiles exist, which is not the same as the filtered list above.
    in property <int> profile-count;
    in-out property <int> selected: -1;
    // Index of the profile with a running openvpn process, or -1.
    in property <int> active: -1;
    // Index of the profile the status fields below describe, kept after it stops.
    in property <int> status-for: -1;
    in property <ConnState> conn-state: ConnState.idle;
    in property <string> status-text;
    in property <string> local-ip: "—";
    in property <string> remote: "—";
    in property <string> rx: "—";
    in property <string> tx: "—";
    in property <string> duration: "—";
    // Download speed samples, oldest first, scaled to 0..1.
    in property <[float]> samples;
    // A short message shown over the window, empty when there is none.
    in property <string> toast;
    in property <bool> toast-error: false;
    in-out property <string> search-query;
    // "en" or "ru", so the language picker knows which button is active.
    in property <string> lang;

    in property <bool> auth-visible;
    in property <bool> auth-needs-username: true;
    in property <bool> auth-needs-password: true;
    in property <bool> auth-needs-code: false;
    // The challenge text the server sent, e.g. "Enter code".
    in property <string> auth-challenge-text;
    // The password comes from the keyring, so only the code is asked for.
    in property <bool> auth-password-saved;
    in property <string> auth-title;
    in property <string> auth-error;
    in-out property <string> auth-username;
    in-out property <string> auth-password;
    in-out property <string> auth-code;
    in-out property <bool> auth-remember;
    in-out property <bool> auth-reveal: false;
    // Index of the profile whose removal is waiting for confirmation, or -1.
    in-out property <int> confirm-remove: -1;
    // The name and keyring state of that profile, so the dialog doesn't have to
    // index into the filtered list.
    in property <string> confirm-title;
    in property <bool> confirm-saved-password;
    in-out property <bool> settings-visible: false;

    // Add-profile dialog: files, clipboard or a link.
    in-out property <bool> add-visible: false;
    in-out property <string> add-url;
    // Rename dialog.
    in-out property <bool> rename-visible: false;
    in-out property <int> rename-index: -1;
    in-out property <string> rename-name;
    in property <string> rename-error;

    // "dark", "light" or "system".
    in property <string> theme-mode: "dark";
    in-out property <bool> autostart: false;
    in-out property <bool> auto-connect: false;
    in-out property <bool> notifications: true;
    // Draw the coral frame around the window.
    in-out property <bool> frame: true;

    in property <string> version;
    in property <UpdateState> update-state: UpdateState.idle;
    // Shown in the banner while an update is available or being installed.
    in property <string> update-text;
    // Shown under the version, e.g. "You're up to date".
    in property <string> update-note;
    in property <float> update-progress;

    callback check-updates();
    callback install-update();
    callback open-release-notes();
    callback restart-app();
    callback dismiss-update();

    callback import-profile();
    callback import-clipboard();
    callback import-url(string);
    callback files-dropped(data-transfer);
    callback remove-profile(int);
    callback forget-password(int);
    callback select-profile(int);
    callback move-selection(int);
    callback request-remove(int);
    callback request-rename(int);
    callback rename-profile(int, string);
    callback view-profile(int);
    callback connect(int);
    callback disconnect();
    callback submit-auth(string, string, string);
    callback cancel-auth();
    callback change-password();
    callback show-log();
    callback hide-window();
    callback set-theme(string);
    callback set-language(string);
    callback set-autostart(bool);
    callback set-auto-connect(bool);
    callback set-notifications(bool);
    callback set-frame(bool);
    callback search-changed(string);

    property <bool> has-selection: root.selected >= 0 && root.selected < root.profile-count;
    property <bool> busy: root.active >= 0;
    property <bool> can-check: root.update-state == UpdateState.idle || root.update-state == UpdateState.failed;
    // While a connection runs, the card always describes it, whichever row is selected.
    property <bool> shows-status: root.busy || (root.has-selection && root.selected == root.status-for);
    property <ConnState> shown-state: root.shows-status ? root.conn-state : ConnState.idle;
    // The name of the profile the card describes, filled in from Rust because the
    // list above is filtered and its indices don't match the store.
    in property <string> card-name;
    in property <string> card-remote;
    property <color> state-color: root.shown-state == ConnState.connected ? Theme.accent
        : root.shown-state == ConnState.error ? Theme.bad
        : root.shown-state == ConnState.idle ? Theme.dim
        : Theme.warn;
    property <string> state-label: root.shown-state == ConnState.connected ? Labels.state-connected
        : root.shown-state == ConnState.connecting ? Labels.state-connecting
        : root.shown-state == ConnState.disconnecting ? Labels.state-disconnecting
        : root.shown-state == ConnState.error ? Labels.state-error
        : Labels.state-idle;
    // Drives the pulsing dot while a connection is being set up.
    property <bool> pulse-on: true;
    property <bool> show-search: root.profile-count > 2;
    // A dialog owns the keyboard: Escape closes it and nothing else gets through.
    property <bool> modal-open: root.settings-visible || root.add-visible || root.rename-visible
        || root.confirm-remove >= 0 || root.auth-visible;

    changed search-query => {
        root.search-changed(root.search-query);
    }

    changed add-visible => {
        if root.add-visible {
            root.add-url = "";
        }
    }

    // The dot breathes while connecting, so the app looks alive during the wait.
    pulse := Timer {
        interval: 700ms;
        running: root.shown-state == ConnState.connecting;
        triggered => {
            root.pulse-on = !root.pulse-on;
        }
    }

    // The niri frame: 3px of coral around a 26px-radius surface.
    Rectangle {
        x: root.frame-width;
        y: root.frame-width;
        width: parent.width - 2 * root.frame-width;
        height: parent.height - 2 * root.frame-width;
        border-radius: root.frame ? 23px : 0px;
        background: Theme.bg-glow;
        clip: true;

        // Keyboard: Ctrl+F search, Ctrl+L log, arrows move, Enter connects.
        keys := FocusScope {
            width: parent.width;
            height: parent.height;
            init => {
                self.focus();
            }

            key-pressed(event) => {
                // A dialog is open: Escape closes it, everything else is its own.
                if root.modal-open {
                    if event.text == Key.Escape {
                        if root.settings-visible {
                            root.settings-visible = false;
                        } else if root.add-visible {
                            root.add-visible = false;
                        } else if root.rename-visible {
                            root.rename-visible = false;
                        } else if root.confirm-remove >= 0 {
                            root.confirm-remove = -1;
                        } else if root.auth-visible {
                            root.cancel-auth();
                        }
                    }
                    return accept;
                }
                if event.modifiers.control && (event.text == "f" || event.text == "F") {
                    if root.show-search {
                        search.focus-input();
                    }
                    return accept;
                }
                if event.modifiers.control && (event.text == "l" || event.text == "L") {
                    root.show-log();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-selection(1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-selection(-1);
                    return accept;
                }
                if event.text == Key.Return {
                    if root.busy {
                        root.disconnect();
                    } else if root.has-selection {
                        root.connect(root.selected);
                    }
                    return accept;
                }
                if event.text == Key.Escape && root.search-query != "" {
                    root.search-query = "";
                    return accept;
                }
                reject
            }

            VerticalLayout {
                TitleBar {
                    title: "Ether (ether-ovpn)";
                    spec: "vpn";
                    show-logo: true;
                    show-actions: true;
                    close => {
                        root.hide-window();
                    }
                    log => {
                        root.show-log();
                    }
                    settings => {
                        root.settings-visible = true;
                    }
                }

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    if root.update-state != UpdateState.idle && root.update-state != UpdateState.checking: Card {
                        // Natural height: the banner must not eat the profile list's space.
                        vertical-stretch: 0;
                        fill: root.update-state == UpdateState.failed ? Theme.bad.transparentize(0.9) : Theme.accent-soft;
                        edge: root.update-state == UpdateState.failed ? Theme.bad.transparentize(0.6) : Theme.accent-line;
                        min-height: banner.preferred-height;
                        banner := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Text {
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Theme.text;
                                text: root.update-text;
                            }

                            if root.update-state == UpdateState.downloading: Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.line;
                                Rectangle {
                                    width: parent.width * root.update-progress;
                                    height: parent.height;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 12px;
                                if root.update-state == UpdateState.available: Link {
                                    text: Labels.whats-new;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    clicked => {
                                        root.open-release-notes();
                                    }
                                }

                                if root.update-state == UpdateState.available: Button {
                                    kind: ButtonKind.solid;
                                    text: Labels.update-now;
                                    font-size: 13px;
                                    min-height: 34px;
                                    width: 124px;
                                    clicked => {
                                        root.install-update();
                                    }
                                }

                                if root.update-state == UpdateState.done: Button {
                                    kind: ButtonKind.solid;
                                    text: Labels.restart-app;
                                    font-size: 13px;
                                    min-height: 34px;
                                    width: 168px;
                                    clicked => {
                                        root.restart-app();
                                    }
                                }

                                if root.update-state == UpdateState.failed: Link {
                                    text: Labels.dismiss;
                                    font-size: 12px;
                                    clicked => {
                                        root.dismiss-update();
                                    }
                                }
                            }
                        }
                    }

                    // First run: nothing to connect to yet, so the import is the only action.
                    // The card keeps its natural height and sits in the middle of the
                    // space the profile list would have used.
                    if root.profile-count == 0: VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        Card {
                            vertical-stretch: 0;
                            empty-card := VerticalLayout {
                                padding: 28px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: center;
                                    Logo {
                                        size: 72px;
                                    }
                                }

                                Text {
                                    text: Labels.empty-title;
                                    font-size: 17px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: Labels.empty-hint;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    color: Theme.dim;
                                    horizontal-alignment: center;
                                }

                                Button {
                                    kind: ButtonKind.solid;
                                    text: Labels.import-profiles;
                                    font-size: 14px;
                                    min-height: 44px;
                                    clicked => {
                                        root.add-visible = true;
                                    }
                                }
                            }
                        }
                    }

                    // Status card
                    if root.profile-count > 0: Card {
                        // Natural height: the profile list below is what should scroll.
                        vertical-stretch: 0;
                        min-height: card.preferred-height;
                        // The edge takes the colour of the state, so the card reads at a
                        // glance without a second badge.
                        edge: root.shown-state == ConnState.idle ? Theme.line : root.state-color.transparentize(0.7);
                        card := VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                StatusChip {
                                    text: root.state-label;
                                    tint: root.state-color;
                                    pulse: root.shown-state == ConnState.connecting;
                                    pulse-on: root.pulse-on;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.duration;
                                    font-family: Theme.mono;
                                    font-size: 11.5px;
                                    color: Theme.dim;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    font-size: 24px;
                                    font-weight: 700;
                                    letter-spacing: -0.2px;
                                    color: Theme.text;
                                    overflow: elide;
                                    text: root.card-name != "" ? root.card-name : Labels.choose-profile;
                                }

                                if root.shown-state != ConnState.connected && root.shown-state != ConnState.idle: Text {
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: Theme.dim;
                                    text: root.status-text;
                                }

                                // The server is worth knowing before the tunnel is up.
                                if root.shown-state != ConnState.connected && root.card-remote != "": Text {
                                    font-family: Theme.mono;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                    text: root.card-remote;
                                }
                            }

                            if root.shown-state == ConnState.connected: GridLayout {
                                spacing: 12px;
                                Row {
                                    Stat {
                                        label: Labels.vpn-address;
                                        value: root.local-ip;
                                    }

                                    Stat {
                                        label: Labels.server;
                                        value: root.remote;
                                    }
                                }

                                Row {
                                    Stat {
                                        label: Labels.received;
                                        value: root.rx;
                                    }

                                    Stat {
                                        label: Labels.sent;
                                        value: root.tx;
                                    }
                                }
                            }

                            if root.shown-state == ConnState.connected: Sparkline {
                                samples: root.samples;
                            }
                        }
                    }

                    if root.profile-count > 0: Button {
                        kind: root.busy ? ButtonKind.ghost : ButtonKind.solid;
                        font-size: 15px;
                        min-height: 50px;
                        text: !root.busy ? Labels.connect
                            : root.conn-state == ConnState.disconnecting ? Labels.state-disconnecting
                            : Labels.disconnect;
                        enabled: root.busy ? root.conn-state != ConnState.disconnecting : root.has-selection;
                        clicked => {
                            if root.busy {
                                root.disconnect();
                            } else {
                                root.connect(root.selected);
                            }
                        }
                    }

                    if root.profile-count > 0: HorizontalLayout {
                        padding-top: 2px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text {
                            text: Labels.profiles;
                            font-family: Theme.mono;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            color: Theme.dim;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.profile-count;
                            font-family: Theme.mono;
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent-ink;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            text: Labels.import-label;
                            clicked => {
                                root.add-visible = true;
                            }
                        }
                    }

                    // Only worth the space once the list is long enough to scan.
                    search := Field {
                        visible: root.show-search;
                        placeholder: Labels.search-placeholder;
                        text <=> root.search-query;
                    }

                    if root.profiles.length == 0 && root.profile-count > 0: Text {
                        text: Labels.search-empty;
                        font-size: 13px;
                        color: Theme.dim;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                        vertical-alignment: center;
                    }

                    // With no profiles the empty card owns the free space instead.
                    if root.profile-count > 0: ListView {
                        vertical-stretch: 1;
                        for profile[i] in root.profiles: VerticalLayout {
                            padding-bottom: 4px;
                            ProfileRow {
                                name: profile.name;
                                remote: profile.remote;
                                initials: profile.initials;
                                saved-password: profile.saved-password;
                                selected: profile.index == root.selected;
                                connected: profile.index == root.active && root.conn-state == ConnState.connected;
                                can-remove: profile.index != root.active;
                                clicked => {
                                    root.select-profile(profile.index);
                                }
                                rename => {
                                    root.request-rename(profile.index);
                                }
                                view => {
                                    root.view-profile(profile.index);
                                }
                                remove => {
                                    root.request-remove(profile.index);
                                }
                                forget-password => {
                                    root.forget-password(profile.index);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text {
                                text: "v" + root.version;
                                font-family: Theme.mono;
                                font-size: 10px;
                                color: Theme.dim;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            TextButton {
                                enabled: root.can-check;
                                text: root.update-state == UpdateState.checking ? Labels.checking : Labels.check-updates;
                                clicked => {
                                    root.check-updates();
                                }
                            }
                        }

                        if root.update-note != "": Text {
                            text: root.update-note;
                            font-size: 11px;
                            wrap: word-wrap;
                            color: Theme.dim;
                        }
                    }
                }
            }
        }

        // A short message over the content, gone after a few seconds.
        // A layout anchors it to the bottom: an explicit `y: parent.height - …`
        // makes the window's preferred height depend on itself, and the window
        // then shrinks to the height of its content whenever a toast shows up.
        if root.toast != "": VerticalLayout {
            alignment: end;
            padding: 18px;

            Rectangle {
                horizontal-stretch: 1;
                height: toast-body.preferred-height + 20px;
                border-radius: 14px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-color: Theme.shadow;
                drop-shadow-blur: Theme.shadow-blur;
                drop-shadow-offset-y: 6px;
                clip: true;

                // The 3px accent bar on the left, as on the site's toasts.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 3px;
                    height: parent.height;
                    background: root.toast-error ? Theme.bad : Theme.accent;
                }

                toast-body := VerticalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    Text {
                        text: root.toast;
                        font-size: 12.5px;
                        wrap: word-wrap;
                        color: root.toast-error ? Theme.bad : Theme.text-2;
                    }
                }
            }
        }
    }

    // Dropping .ovpn files anywhere on the window imports them.
    drop := DropArea {
        can-drop(event) => {
            return DragAction.copy;
        }
        dropped(event) => {
            root.files-dropped(event.data);
            return DragAction.copy;
        }
    }

    if drop.has-drag: Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 23px;
        background: Theme.accent.transparentize(0.88);
        Text {
            text: Labels.add-hint;
            font-size: 14px;
            font-weight: 700;
            color: Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.settings-visible: Modal {
        title: Labels.settings;
        cancel => {
            root.settings-visible = false;
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: Labels.theme;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            Segmented {
                first: Labels.dark;
                second: Labels.light;
                third: Labels.system;
                current: root.theme-mode == "light" ? 1 : root.theme-mode == "system" ? 2 : 0;
                picked(index) => {
                    root.set-theme(index == 0 ? "dark" : index == 1 ? "light" : "system");
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: Labels.window;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            SettingRow {
                label: Labels.frame;
                Toggle {
                    label: Labels.frame;
                    checked <=> root.frame;
                    toggled(value) => {
                        root.set-frame(value);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: Labels.language;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            Segmented {
                first: "English";
                second: "Русский";
                current: root.lang == "ru" ? 1 : 0;
                picked(index) => {
                    root.set-language(index == 0 ? "en" : "ru");
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: Labels.startup;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            SettingRow {
                label: Labels.autostart;
                Toggle {
                    label: Labels.autostart;
                    checked <=> root.autostart;
                    toggled(value) => {
                        root.set-autostart(value);
                    }
                }
            }

            SettingRow {
                label: Labels.auto-connect;
                Toggle {
                    label: Labels.auto-connect;
                    checked <=> root.auto-connect;
                    toggled(value) => {
                        root.set-auto-connect(value);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: Labels.notifications;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            SettingRow {
                label: Labels.notify-on;
                Toggle {
                    label: Labels.notify-on;
                    checked <=> root.notifications;
                    toggled(value) => {
                        root.set-notifications(value);
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            padding-top: 4px;
            Button {
                kind: ButtonKind.ghost;
                text: Labels.close;
                font-size: 14px;
                min-height: 40px;
                width: 110px;
                clicked => {
                    root.settings-visible = false;
                }
            }
        }
    }

    if root.add-visible: Modal {
        title: Labels.add-title;
        cancel => {
            root.add-visible = false;
        }

        Button {
            kind: ButtonKind.solid;
            text: Labels.add-files;
            font-size: 14px;
            min-height: 42px;
            clicked => {
                root.add-visible = false;
                root.import-profile();
            }
        }

        Button {
            kind: ButtonKind.ghost;
            text: Labels.add-paste;
            font-size: 14px;
            min-height: 42px;
            clicked => {
                root.import-clipboard();
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: Labels.add-url;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                color: Theme.dim;
            }

            HorizontalLayout {
                spacing: 8px;
                url-field := Field {
                    horizontal-stretch: 1;
                    placeholder: Labels.add-url-placeholder;
                    text <=> root.add-url;
                    accepted => {
                        root.import-url(root.add-url);
                    }
                }

                Button {
                    kind: ButtonKind.outline;
                    text: Labels.continue-button;
                    font-size: 13px;
                    min-height: 42px;
                    width: 104px;
                    enabled: root.add-url != "";
                    clicked => {
                        root.import-url(root.add-url);
                    }
                }
            }
        }

        Text {
            text: Labels.add-hint;
            font-size: 12px;
            wrap: word-wrap;
            color: Theme.dim;
        }

        HorizontalLayout {
            alignment: end;
            padding-top: 2px;
            Button {
                kind: ButtonKind.ghost;
                text: Labels.cancel;
                font-size: 14px;
                min-height: 40px;
                width: 110px;
                clicked => {
                    root.add-visible = false;
                }
            }
        }
    }

    if root.rename-visible: Modal {
        title: Labels.rename-title;
        cancel => {
            root.rename-visible = false;
        }

        rename-field := Field {
            text <=> root.rename-name;
            init => {
                self.focus-input();
            }
            accepted => {
                root.rename-profile(root.rename-index, root.rename-name);
            }
        }

        if root.rename-error != "": Text {
            text: root.rename-error;
            font-size: 13px;
            wrap: word-wrap;
            color: Theme.bad;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            Button {
                kind: ButtonKind.ghost;
                text: Labels.cancel;
                font-size: 14px;
                min-height: 40px;
                clicked => {
                    root.rename-visible = false;
                }
            }

            Button {
                kind: ButtonKind.solid;
                text: Labels.rename;
                font-size: 14px;
                min-height: 40px;
                clicked => {
                    root.rename-profile(root.rename-index, root.rename-name);
                }
            }
        }
    }

    if root.confirm-remove >= 0: Modal {
        title: root.confirm-title;
        cancel => {
            root.confirm-remove = -1;
        }

        Text {
            text: root.confirm-saved-password ? Labels.remove-body-saved : Labels.remove-body;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.dim;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            Button {
                kind: ButtonKind.ghost;
                text: Labels.cancel;
                font-size: 14px;
                min-height: 40px;
                init => {
                    self.focus();
                }
                clicked => {
                    root.confirm-remove = -1;
                }
            }

            Button {
                kind: ButtonKind.solid;
                text: Labels.remove;
                font-size: 14px;
                min-height: 40px;
                clicked => {
                    root.remove-profile(root.confirm-remove);
                    root.confirm-remove = -1;
                }
            }
        }
    }

    if root.auth-visible: Modal {
        title: root.auth-title;
        cancel => {
            root.cancel-auth();
        }

        if root.auth-password-saved: Text {
            text: Labels.password-saved-hint;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.dim;
        }

        if root.auth-needs-username: Field {
            placeholder: Labels.username;
            text <=> root.auth-username;
            init => {
                if root.auth-username == "" {
                    self.focus-input();
                }
            }
            accepted => {
                password-edit.focus-input();
            }
        }

        password-edit := Field {
            visible: root.auth-needs-password;
            placeholder: Labels.password;
            password: true;
            reveal: root.auth-reveal;
            text <=> root.auth-password;
            init => {
                if root.auth-needs-password && (!root.auth-needs-username || root.auth-username != "") {
                    self.focus-input();
                }
            }
            accepted => {
                if root.auth-needs-code {
                    code-edit.focus-input();
                } else {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }

        if root.auth-needs-password: Check {
            text: Labels.show-password;
            checked <=> root.auth-reveal;
        }

        VerticalLayout {
            visible: root.auth-needs-code;
            spacing: 6px;
            if root.auth-challenge-text != "": Text {
                text: root.auth-challenge-text;
                wrap: word-wrap;
                font-size: 13px;
                color: Theme.dim;
            }

            code-edit := Field {
                placeholder: Labels.code;
                password: true;
                text <=> root.auth-code;
                init => {
                    if !root.auth-needs-password {
                        self.focus-input();
                    }
                }
                accepted => {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }

        if root.auth-needs-password: Check {
            text: Labels.remember-password;
            checked <=> root.auth-remember;
        }

        if root.auth-password-saved: Link {
            text: Labels.change-password;
            font-size: 13px;
            clicked => {
                root.change-password();
            }
        }

        if root.auth-error != "": Text {
            text: root.auth-error;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.bad;
        }

        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            Button {
                kind: ButtonKind.ghost;
                text: Labels.cancel;
                font-size: 14px;
                min-height: 40px;
                clicked => {
                    root.cancel-auth();
                }
            }

            Button {
                kind: ButtonKind.solid;
                text: root.auth-needs-password ? Labels.sign-in : Labels.continue-button;
                font-size: 14px;
                min-height: 40px;
                clicked => {
                    root.submit-auth(root.auth-username, root.auth-password, root.auth-code);
                }
            }
        }
    }
}

export component LogWindow inherits Window {
    title: Labels.log-title;
    icon: @image-url("../assets/ether-256.png");
    preferred-width: 760px;
    preferred-height: 460px;
    default-font-size: 14px;
    default-font-family: Theme.font-family;
    background: root.frame ? Theme.accent : Theme.bg-glow;
    property <length> frame-width: root.frame ? 3px : 0px;

    in property <[LogLine]> lines;
    in property <int> count;
    in-out property <string> filter;
    // Draw the coral frame around the window.
    in property <bool> frame: true;
    callback copy-all();
    callback copy-diagnostics();
    callback save();
    callback clear();
    callback filter-changed(string);
    callback close-window();

    // Whether new lines scroll into view; off while the user reads further up.
    property <bool> follow: true;

    changed count => {
        if root.follow {
            log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
        }
    }

    changed filter => {
        root.filter-changed(root.filter);
    }

    Rectangle {
        x: root.frame-width;
        y: root.frame-width;
        width: parent.width - 2 * root.frame-width;
        height: parent.height - 2 * root.frame-width;
        border-radius: root.frame ? 23px : 0px;
        background: Theme.bg-glow;
        clip: true;

        VerticalLayout {
            TitleBar {
                title: Labels.log-title;
                spec: "log";
                close => {
                    root.close-window();
                }
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Field {
                        horizontal-stretch: 1;
                        placeholder: Labels.log-filter-placeholder;
                        text <=> root.filter;
                    }

                    TextButton {
                        text: Labels.diagnostics;
                        clicked => {
                            root.copy-diagnostics();
                        }
                    }

                    TextButton {
                        text: Labels.copy-all;
                        enabled: root.lines.length > 0;
                        clicked => {
                            root.copy-all();
                        }
                    }

                    TextButton {
                        text: Labels.save;
                        enabled: root.lines.length > 0;
                        clicked => {
                            root.save();
                        }
                    }

                    TextButton {
                        text: Labels.clear;
                        enabled: root.lines.length > 0;
                        clicked => {
                            root.clear();
                        }
                    }
                }

                if root.lines.length == 0: Text {
                    color: Theme.dim;
                    font-size: 13px;
                    text: root.filter == "" ? Labels.log-empty : Labels.log-nothing-found;
                    wrap: word-wrap;
                }

                log-view := ListView {
                    vertical-stretch: 1;
                    scrolled => {
                        root.follow = self.content-y <= self.visible-height - self.content-height + 24px;
                    }
                    for line in root.lines: Text {
                        text: line.text;
                        wrap: word-wrap;
                        font-family: Theme.mono;
                        font-size: 11.5px;
                        color: line.level == 2 ? Theme.bad : line.level == 1 ? Theme.warn : Theme.text-2;
                    }
                }
            }
        }
    }
}

// The profile as text, with a pre-connect check on top. Read-only: editing a
// profile by hand is what the file manager is for.
export component ProfileWindow inherits Window {
    title: Labels.view-title;
    icon: @image-url("../assets/ether-256.png");
    preferred-width: 720px;
    preferred-height: 560px;
    default-font-size: 14px;
    default-font-family: Theme.font-family;
    background: root.frame ? Theme.accent : Theme.bg-glow;
    property <length> frame-width: root.frame ? 3px : 0px;

    in property <string> profile-name;
    in property <string> profile-remote;
    in property <[ProfileLine]> lines;
    in property <[CheckLine]> checks;
    in property <bool> checking;
    in property <bool> has-risky;
    // Draw the coral frame around the window.
    in property <bool> frame: true;
    callback check();
    callback copy();
    callback close-window();

    Rectangle {
        x: root.frame-width;
        y: root.frame-width;
        width: parent.width - 2 * root.frame-width;
        height: parent.height - 2 * root.frame-width;
        border-radius: root.frame ? 23px : 0px;
        background: Theme.bg-glow;
        clip: true;

        VerticalLayout {
            TitleBar {
                title: Labels.view-title;
                spec: "profile";
                close => {
                    root.close-window();
                }
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.profile-name;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }

                        if root.profile-remote != "": Text {
                            text: root.profile-remote;
                            font-family: Theme.mono;
                            font-size: 11px;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }

                    TextButton {
                        text: root.checking ? Labels.view-checking : Labels.view-check;
                        enabled: !root.checking;
                        clicked => {
                            root.check();
                        }
                    }
                }

                if root.has-risky: Rectangle {
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.warn.transparentize(0.5);
                    background: Theme.warn.transparentize(0.92);
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        Text {
                            text: Labels.view-risky;
                            font-size: 12px;
                            color: Theme.warn;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.checks.length > 0: VerticalLayout {
                    spacing: 6px;
                    for check in root.checks: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: check.state == 0 ? Theme.accent : check.state == 1 ? Theme.bad : Theme.dim;
                        }

                        Text {
                            text: check.label;
                            font-size: 12px;
                            color: Theme.text-2;
                            width: 150px;
                            overflow: elide;
                        }

                        Text {
                            text: check.detail;
                            font-family: Theme.mono;
                            font-size: 11px;
                            color: check.state == 1 ? Theme.bad : Theme.dim;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for line in root.lines: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: "\{line.number}";
                            width: 34px;
                            horizontal-alignment: end;
                            font-family: Theme.mono;
                            font-size: 11.5px;
                            color: Theme.dim;
                        }

                        Text {
                            text: line.text;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            font-family: Theme.mono;
                            font-size: 11.5px;
                            color: line.risky ? Theme.warn : Theme.text-2;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    TextButton {
                        text: Labels.view-copy;
                        clicked => {
                            root.copy();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        kind: ButtonKind.ghost;
                        text: Labels.view-close;
                        font-size: 14px;
                        min-height: 38px;
                        clicked => {
                            root.close-window();
                        }
                    }
                }
            }
        }
    }
}
