import { ListView } from "std-widgets.slint";

export enum ConnState { idle, connecting, connected, disconnecting, error }

export struct ProfileInfo {
    // Index in the store, so a filtered list still maps back to the right profile.
    index: int,
    name: string,
    saved-password: bool,
    // host:port from the profile's remote line, shown before connecting.
    remote: string,
    // One or two letters for the row's avatar.
    initials: string,
}

// One line of openvpn output. level: 0 ordinary, 1 warning, 2 error.
export struct LogLine {
    text: string,
    level: int,
}

// One line of a profile, with the number shown next to it.
export struct ProfileLine {
    number: int,
    text: string,
    // A directive that makes openvpn run a program, which it does as root.
    risky: bool,
}

// One result of the pre-connect check. state: 0 passed, 1 failed, 2 skipped.
export struct CheckLine {
    label: string,
    detail: string,
    state: int,
}

export enum UpdateState { idle, checking, available, downloading, installing, done, failed }

// Every user-visible string. Filled from Rust by i18n::apply, so the UI never
